# StackGen Environment Variables
# Copy this file to .env and fill in your real values

# Groq API Key (used for LLM routing)
GROQ_API_KEY=gsk_your_groq_api_key_here

# GitHub Integrations
# User 1 (Alice)
GITHUB_TOKEN_USER1=github_pat_user1_token_here
GITHUB_USERNAME_USER1=alice-github

# User 2 (Bob)
GITHUB_TOKEN_USER2=github_pat_user2_token_here
GITHUB_USERNAME_USER2=bob-github

# Linear Integrations
# User 1 (Alice)
LINEAR_API_KEY_USER1=lin_api_user1_key_here
LINEAR_USERNAME_USER1=alice-linear

# User 2 (Bob)
LINEAR_API_KEY_USER2=lin_api_user2_key_here
LINEAR_USERNAME_USER2=bob-linear
